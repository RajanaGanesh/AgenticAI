# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database & Queue (Leave empty for automatic zero-config in-memory fallback)
MONGODB_URI=mongodb://localhost:27017/agentflow_ai
REDIS_URL=redis://localhost:6379

# Security Secrets (Must be 32+ characters in production)
JWT_SECRET=agentflow_jwt_secret_dev_key_super_secure_987654321
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=e83921bf7a8e90c4871e23f9901d84a1e83921bf7a8e90c4871e23f9901d84a1

# AI Providers (Optional - Platform will use built-in deterministic rule-engine if not configured)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Third-Party Integrations OAuth (Optional for local testing / manual config)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
